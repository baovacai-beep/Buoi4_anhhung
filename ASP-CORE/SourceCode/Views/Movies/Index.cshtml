@model IEnumerable<_31241023360_HoGiaBao.Models.Movie>

@{
    ViewData["Title"] = "Index";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>31241023360 - Hồ Gia Bảo</h2>
    <a class="btn btn-success" asp-action="Create">Thêm mới</a>
</div>

<div class="container">
    <div class="row grid-demo">
        @foreach (var item in Model)
        {
            <div class="col-12 col-sm-6 col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <img src="@item.PicturePath" class="card-img-top" style="width: 100%; height: 260px; object-fit: cover;" alt="@item.Title" />
                    <div class="card-body d-flex flex-column">
                        <p class="mb-1"><strong>@Html.DisplayNameFor(model => model.Title):</strong> @Html.DisplayFor(modelItem => item.Title)</p>
                        <p class="mb-1"><strong>@Html.DisplayNameFor(model => model.Rated):</strong> @Html.DisplayFor(modelItem => item.Rated)</p>
                        <p class="mb-1"><strong>@Html.DisplayNameFor(model => model.Price):</strong> @Html.DisplayFor(modelItem => item.Price) VNĐ</p>
                        <p class="mb-1"><strong>@Html.DisplayNameFor(model => model.Summary):</strong> @Html.DisplayFor(modelItem => item.Summary)</p>
                        <p class="mb-1"><strong>@Html.DisplayNameFor(model => model.ReleaseDate):</strong> @item.ReleaseDate.ToString("dd/MM/yyyy")</p>
                        <p class="mb-3"><strong>@Html.DisplayNameFor(model => model.Genre):</strong> @Html.DisplayFor(modelItem => item.GenreObj.Name)</p>
                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <a class="btn btn-primary" asp-action="AddToCart" asp-route-id="@item.ID">Mua</a>
                            <div class="btn-group btn-group-sm">
                                <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@item.ID">Sửa</a>
                                <a class="btn btn-outline-info" asp-action="Details" asp-route-id="@item.ID">Chi tiết</a>
                                <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@item.ID">Xóa</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
